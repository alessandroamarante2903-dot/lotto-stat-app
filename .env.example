# =====================================================================
# .env.example — copia in ".env" (mai committare il .env reale) e
# valorizza tutte le variabili prima di lanciare "podman-compose up -d".
# podman-compose (come docker-compose) carica automaticamente il file
# ".env" nella stessa cartella del file *-compose.yml.
# =====================================================================

# --- MySQL (container lotto_stat_db) ---------------------------------
# Password dell'utente root di MySQL, usata solo per l'inizializzazione
# del container e per l'esecuzione manuale una tantum dei file in
# db/init-scripts/views/ (vedi db/init-scripts/README.md).
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

# Credenziali applicative usate da scraper.py / update_pipeline.py / web/app.py
# Devono combaciare con l'utente creato in db/init-scripts/init.sql.
DB_NAME=lotto_statistics
DB_USER=statistics_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Grafana (container lotto_stat_grafana) ---------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# --- Fonti dati opzionali per il live update SuperEnalotto (FASE 3) ---
# Se non impostate, i relativi provider si auto-escludono e lo scraper
# ricade sullo scraping HTML di lottoced.com (vedi backend/scraper.py).
RAPIDAPI_KEY=
MAGAYO_API_KEY=
MAGAYO_GAME_CODE=italy_superenalotto

# --- Logging -----------------------------------------------------------
LOG_LEVEL=INFO
